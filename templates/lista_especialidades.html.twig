{% block meta_description %}Listado completo de especialidades docentes con adjudicaciones registradas en el SIPRI de la Junta de Andalucía.{% endblock %}
{% block og_image %}og/especialidad.png{% endblock %}

{% block body %}
    <h2>Plazas</h2>

