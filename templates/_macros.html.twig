{# Celda de posición adjudicada.

   `ordenes`   texto con las posiciones llamadas (vacío si no hay ninguna)
   `sinCubrir` puestos de la plaza que no llegaron a adjudicarse
   `numero`    puestos que oferta la plaza

   Una plaza puede ofertar varios puestos, así que puede quedar desierta del todo
   o solo en parte. `sinCubrir` llega a 0 cuando la convocatoria no tiene
   adjudicaciones extraídas: entonces no se sabe si quedó desierta y se muestra
   un guion. #}
{% macro posicionAdjudicada(ordenes, sinCubrir, numero) %}
    {%- if ordenes %}{{ ordenes }}{% endif -%}
    {%- if sinCubrir > 0 -%}
        {%- if ordenes %} {% endif -%}
        <span class="text-muted" title="{{ sinCubrir == numero ? 'Desierta, no adjudicada o sin adjudicación conocida' : sinCubrir ~ ' de los ' ~ numero ~ ' puestos de esta plaza quedaron desiertos, no adjudicados o sin adjudicación conocida' }}">
            {{- sinCubrir == numero ? 'Desierta*' : '+' ~ sinCubrir ~ ' desierta' ~ (sinCubrir > 1 ? 's' : '') ~ '*' -}}
        </span>
    {%- elseif not ordenes -%}
        –
    {%- endif -%}
{% endmacro %}

{# Nota al pie que explica el asterisco de las plazas desiertas #}
{% macro notaDesiertas() %}
    <p class="text-muted small mt-2">
        * Desierta, no adjudicada o sin adjudicación conocida. Consulta las
        <a href="{{ path('app_faq') }}">preguntas frecuentes</a>.
    </p>
{% endmacro %}
