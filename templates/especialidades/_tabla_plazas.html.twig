{# Tabla de plazas de una especialidad. `mostrarProvincia` añade la columna de
   provincia y los atributos que usan los filtros en cliente.

   El marcado va comprimido a propósito: estas tablas llegan a 4.450 filas y se
   publican como HTML estático, así que cada byte por fila se multiplica. #}
{% import '_macros.html.twig' as macros %}
{% set mostrarProvincia = mostrarProvincia|default(false) %}

<div class="table-responsive">
    <table class="table table-hover tabla-plazas">
        <thead>
            <tr>
                <th>Convocatoria</th>
                {% if mostrarProvincia %}<th>Provincia</th>{% endif %}
                <th>Localidad</th>
                <th>Centro</th>
                <th>Tipo</th>
                <th class="text-end">Nº</th>
                <th>F. Cese</th>
                <th class="text-end">Posición adj.</th>
            </tr>
        </thead>
        <tbody>
        {%- set convoPrevia = null -%}
        {%- for plaza in plazas -%}
            {%- set esVacante = plaza.tipo == constant('App\\Enum\\TipoPlazaEnum::VACANTE') -%}
            {#- Las filas llegan agrupadas por convocatoria: la primera de cada grupo
                lleva un borde superior más marcado. Al filtrar en cliente el grupo
                cambia, así que `filtros_plazas_controller` recalcula la clase. -#}
            {%- set nuevaConvocatoria = convoPrevia is not null and convoPrevia != plaza.convocatoria.id -%}
            {%- set convoPrevia = plaza.convocatoria.id -%}
            {%- apply spaceless -%}
            <tr{% if nuevaConvocatoria %} class="tr-convo-ini"{% endif %}{% if mostrarProvincia %} data-filtros-plazas-target="fila" data-convo="{{ plaza.convocatoria.id }}" data-prov="{{ plaza.centro.localidad.provincia.id }}" data-tipo="{{ esVacante ? 'V' : 'S' }}" data-numero="{{ plaza.numero }}" data-inicio="{{ plaza.convocatoria.fecha and plaza.convocatoria.fecha|date('m') == '09' ? '1' : '0' }}" data-sin-cubrir="{{ sinCubrir[plaza.id]|default(0) }}" data-adj="{{ plaza.adjudicaciones is not empty ? plaza.adjudicacionesAsString : '' }}"{% endif %}>
                <td class="td-nowrap">
                    <a href="{{ path('app_convocatoria_detalle', { id: plaza.convocatoria.id }) }}" class="badge-code text-decoration-none">{{ plaza.convocatoria.id }}</a>
                    <span class="td-fecha">{{ plaza.convocatoria.fecha|date('d/m/Y') }}</span>
                </td>
                {%- if mostrarProvincia %}
                <td class="td-nowrap">
                    <a href="{{ path('app_especialidad_curso', { especialidad: especialidad.id, curso: curso.id }) ~ '?prov=' ~ plaza.centro.localidad.provincia.id }}" class="td-link">{{ plaza.centro.localidad.provincia.nombre }}</a>
                </td>
                {%- endif %}
                <td class="td-muted td-nowrap">{{ plaza.centro.localidad.nombre }}</td>
                <td>
                    <a href="{{ path('app_centro_detalle', { id: plaza.centro.id }) }}" class="td-link fw-medium">{{ plaza.centro.nombre }}</a>
                    <span class="badge-code td-code">{{ plaza.centro.id }}</span>
                </td>
                <td><span class="badge {{ esVacante ? 'badge-vacante' : 'badge-sustitucion' }}">{{ plaza.tipo.getLabel() }}</span></td>
                <td class="text-end">{{ plaza.numero }}</td>
                <td class="td-muted td-nowrap">{{ plaza.fechaPrevistaCese ? plaza.fechaPrevistaCese|date('d/m/Y') : '–' }}</td>
                <td class="text-end font-monospace">
                    {{- macros.posicionAdjudicada(
                        plaza.adjudicaciones is not empty ? plaza.adjudicacionesAsString : '',
                        sinCubrir[plaza.id]|default(0),
                        plaza.numero
                    ) -}}
                </td>
            </tr>
            {%- endapply -%}
        {%- endfor -%}
        </tbody>
    </table>
</div>

{{ macros.notaDesiertas() }}
