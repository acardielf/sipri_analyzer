{# Resumen de puestos del curso. Todo se cuenta en puestos ofertados, no en
   filas de plaza: una plaza puede ofertar varios. #}
{# `default(true)` no serviría: el filtro se dispara con valores vacíos, así que
   convertiría un `false` explícito en `true` #}
{% set mostrarPosiciones = mostrarPosiciones is defined ? mostrarPosiciones : true %}
{% set sobrevenidas = stats.vacantes - stats.vacantesInicio %}
{% set pctInicio = stats.vacantes > 0 ? (stats.vacantesInicio / stats.vacantes * 100)|round : 0 %}

<div class="stats-grid mb-4">

    <div class="stat-card">
        <div class="stat-num" style="color:var(--sipri-blue)">{{ stats.plazas }}</div>
        <div class="stat-label">Plazas ofertadas</div>
        <div class="stat-foot">
            <strong>{{ stats.vacantes }}</strong> vacante{{ stats.vacantes != 1 ? 's' }}
            + <strong>{{ stats.sustituciones }}</strong> sustitucion{{ stats.sustituciones != 1 ? 'es' : '' }}
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-num" style="color:var(--sipri-vacante)">{{ stats.vacantes }}</div>
        <div class="stat-label"><i class="bi bi-calendar-check me-1"></i>Vacantes</div>
        {% if stats.vacantes > 0 %}
            <div class="stat-split" title="{{ stats.vacantesInicio }} en septiembre y {{ sobrevenidas }} {{ sobrevenidas == 1 ? 'surgida' : 'surgidas' }} después">
                {# La barra solo aporta cuando hay mezcla de ambas #}
                {% if stats.vacantesInicio > 0 and sobrevenidas > 0 %}
                    <div class="stat-split-bar">
                        <span style="width:{{ pctInicio }}%"></span>
                    </div>
                {% endif %}
                <div class="stat-foot">
                    {% if stats.vacantesInicio > 0 %}
                        <i class="bi bi-sunrise" style="color:var(--sipri-vacante)"></i>
                        {% if sobrevenidas > 0 %}
                            <strong>{{ stats.vacantesInicio }}</strong> durante septiembre
                            · <strong>{{ sobrevenidas }}</strong> después
                        {% else %}
                            todas de inicio de curso
                        {% endif %}
                        {%- if stats.vacantesDesiertas > 0 %}<br>{% endif %}
                    {% endif %}
                    {%- if stats.vacantesDesiertas > 0 -%}
                        <strong class="text-danger">{{ stats.vacantesDesiertas }}</strong> sin cubrir
                    {%- elseif stats.vacantesInicio == 0 -%}
                        <strong>{{ stats.vacantesAdjudicadas }}</strong> adjudicada{{ stats.vacantesAdjudicadas != 1 ? 's' }}
                    {%- endif -%}
                </div>
            </div>
        {% else %}
            <div class="stat-foot">Sin vacantes</div>
        {% endif %}
    </div>

    <div class="stat-card">
        <div class="stat-num" style="color:var(--sipri-sustitucion)">{{ stats.sustituciones }}</div>
        <div class="stat-label"><i class="bi bi-arrow-repeat me-1"></i>Sustituciones</div>
        <div class="stat-foot">
            <strong>{{ stats.sustitucionesAdjudicadas }}</strong> adjudicadas
            · <strong class="text-danger">{{ stats.sustitucionesDesiertas }}</strong> desiertas
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-num" style="color:var(--sipri-blue-mid)">{{ stats.adjudicadas }}</div>
        <div class="stat-label"><i class="bi bi-person-check me-1"></i>Adjudicadas</div>
        <div class="stat-foot">
            <strong>{{ stats.vacantesAdjudicadas }}</strong> vacante{{ stats.vacantesAdjudicadas != 1 ? 's' }}
            + <strong>{{ stats.sustitucionesAdjudicadas }}</strong> sustitucion{{ stats.sustitucionesAdjudicadas != 1 ? 'es' : '' }}
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-num" style="color:var(--sipri-muted)">{{ stats.desiertas }}</div>
        <div class="stat-label"><i class="bi bi-dash-circle me-1"></i>Desiertas</div>
        <div class="stat-foot">
            <strong class="text-danger">{{ stats.vacantesDesiertas }}</strong> vacante{{ stats.vacantesDesiertas != 1 ? 's' }}
            + <strong class="text-danger">{{ stats.sustitucionesDesiertas }}</strong> sustitucion{{ stats.sustitucionesDesiertas != 1 ? 'es' : '' }}
        </div>
    </div>

    {# En una convocatoria suelta el rango de posiciones mezcla todas las
       especialidades, así que no dice nada: solo se muestra por curso #}
    {% if mostrarPosiciones %}
    <div class="stat-card">
        {% if stats.maxOrden > 0 %}
            <div class="stat-num stat-num--rango">
                nº
                <span style="color:var(--sipri-blue-mid)">{{ stats.minOrden }}</span>
                <span class="stat-rango-sep">–</span>
                <span style="color:var(--sipri-accent)">{{ stats.maxOrden }}</span>
            </div>
            <div class="stat-label"><i class="bi bi-list-ol me-1"></i>Posiciones llamadas</div>
            <div class="stat-foot">primera y última de la bolsa</div>
        {% else %}
            <div class="stat-num stat-num--rango" style="color:var(--sipri-muted)">–</div>
            <div class="stat-label"><i class="bi bi-list-ol me-1"></i>Posiciones llamadas</div>
            <div class="stat-foot">sin posiciones registradas</div>
        {% endif %}
    </div>
    {% endif %}

</div>
